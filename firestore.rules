rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.uid == request.auth.uid;
    }

    function isValidBookmark(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.articleId is string && data.articleId.size() <= 256 &&
             data.articleTitle is string && data.articleTitle.size() <= 512;
    }

    function isValidComment(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.articleId is string && data.articleId.size() <= 256 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000;
    }

    function isValidReaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.articleId is string && data.articleId.size() <= 256 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.type is string && data.type in ['like', 'love', 'insightful', 'sad'];
    }

    function isValidFeedback(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow delete: if false;

      // User Bookmarks Subcollection
      match /bookmarks/{bookmarkId} {
        allow read, write: if isValidId(userId) && isValidId(bookmarkId) && isOwner(userId);
      }
    }

    // Public Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isValidId(commentId) && isSignedIn() && isValidComment(incoming());
      allow delete: if isValidId(commentId) && isSignedIn() && existing().userId == request.auth.uid;
      allow update: if false;
    }

    // Article Reactions
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if isValidId(reactionId) && isSignedIn() && isValidReaction(incoming());
      allow delete: if isValidId(reactionId) && isSignedIn() && existing().userId == request.auth.uid;
      allow update: if false;
    }

    // User Feedback
    match /feedback/{feedbackId} {
      allow create: if isValidId(feedbackId) && isSignedIn() && isValidFeedback(incoming());
      allow read, update, delete: if false;
    }
  }
}
